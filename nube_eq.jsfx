in_pin:Entrada oL
in_pin:Entrada oR
in_pin:Sidechain oL
in_pin:Sidechain oR
out_pin:Salida oL
out_pin:Salida oR

options:gfx_hz=60 no_meter

@init
ext_noinit = 1;
gfx_ext_retina = 1;

NB = 16;          // bandas
NP = 12;          // parametros por banda
P0 = 11;          // slider de la primera banda
BSZ = 128;        // memoria por banda

bandmem  = 0;       // NB*BSZ = 2048
listmem  = 2100;    // bandas activas en orden
solop    = 2200;    // etapa del solo (8)
solost   = 2210;    // estados del solo (4)
anaPost  = 4096;    ANAN = 8192;
anaPre   = 16384;
fftbuf   = 65536;   FFTN = 4096;
specPost = 131072;  // 2048 bins suavizados (dB)
specPre  = 135168;
hitmem   = 140000;  // rectangulos clicables (5 valores c/u)
totMain  = 150000;  // curva total por columna
totSide  = 154000;
colT     = 158000;  // tan(pi f / fs) por columna
colF     = 162000;  // frecuencia por columna

// ---------------------------------------------------------------- utilidades
function clamp(x, a, b) ( x < a ? a : x > b ? b : x );
function db2a(x) ( 10 ^ (x / 20) );
function nlog(v, a, b) ( log(v / a) / log(b / a) );
function dlog(n, a, b) ( a * (b / a) ^ n );
function nlin(v, a, b) ( (v - a) / (b - a) );
function dlin(n, a, b) ( a + (b - a) * n );
function r10(x) ( floor(x * 10 + 0.5) / 10 );
function r100(x) ( floor(x * 100 + 0.5) / 100 );

